###############################################################################
### Sepolia Testnet Environment Variables                                   ###
### Copy to .env.sepolia and fill in your values                            ###
### NEVER commit actual secrets to version control                          ###
###                                                                         ###
### The Sepolia migration mirrors the mainnet flow:                         ###
###   sepolia-deploy-csr  →  bootstrap CSR (no mainnet analog)              ###
###   sepolia-deploy-stage1   ≅  just deploy-stage1 <network> (mainnet)     ###
###   sepolia-verify-stage1   ≅  just verify-stage1 <network> (mainnet)     ###
###   sepolia-migrate-stage2  ≅  just migrate-stage2 <network> (mainnet)    ###
###   sepolia-upgrade-l1      ≅  just migrate-l1                            ###
###                                                                         ###
### Run each with: just -E .env.sepolia <recipe>                            ###
###############################################################################

# ===========================================
# RPC URLs (required everywhere)
# ===========================================
L1_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
L2_OPTIMISM_SEPOLIA_RPC_URL=https://opt-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Convenience aliases consumed by mainnet-shape recipes (verify-stage1, etc.)
L1_RPC_URL=$L1_SEPOLIA_RPC_URL
L2_RPC_URL=$L2_OPTIMISM_SEPOLIA_RPC_URL

# ===========================================
# Step 0 — sepolia-deploy-csr (bootstrap CSR infrastructure)
# ===========================================
# Funded with Sepolia ETH on both chains. Becomes the bootstrap CSR's deployer + the
# initial owner of the LidoCustomReceiver / CustomSender proxies. For testnet you can
# reuse this key as INITIAL_OWNER_PRIVATE_KEY in step 2 (mainnet keeps them distinct).
DEPLOYER_PRIVATE_KEY=0x...

# ===========================================
# Step 1 — sepolia-deploy-stage1 (Lido Deployer deploys new pool + sync infra)
# ===========================================
# Outputs of step 0 (sepolia-deploy-csr): paste the addresses it printed.
L2_BOOTSTRAP_SYNC_AUTOMATION=0x...
L2_CUSTOM_SENDER=0x...
L2_PROXY_ADMIN=0x...
L2_PRICE_ORACLE=0x...

# Distinct key for the Stage-1 deployer — keep it separate from DEPLOYER_PRIVATE_KEY so
# the post-migration `hasRole(DEFAULT_ADMIN_ROLE, l2LidoDeployer) == false` state-mate
# check actually exercises the role-revoke (using the same key collapses the assertion).
L2_LIDO_DEPLOYER_PRIVATE_KEY=0x...

# Final owners. On mainnet L2_LIQUIDITY_OWNER is the LOL multisig (Safe): it owns the new
# OraclePool + CREReceiver AND is the CRE workflow owner = CREReceiver.expectedAuthor (ADR-0001).
# On testnet these can be plain EOAs; the example wires liquidity owner = governance executor
# (no LOL multisig on testnet). Use a Gnosis Safe Sepolia deployment if you want to exercise the
# multisig signing path + `cre workflow deploy --unsigned` (execute the emitted calldata from the Safe).
L2_GOVERNANCE_EXECUTOR=0x...
# L2_LIQUIDITY_OWNER=0x...        # optional, defaults to L2_GOVERNANCE_EXECUTOR; this is the
#                                 # CRE workflow owner / CREReceiver.expectedAuthor pin
# CRE_WORKFLOW_OWNER=0x...        # optional, defaults to L2_LIQUIDITY_OWNER; the Safe that owns
#                                 # the CRE workflow (used by deploy-cre-workflow --unsigned)

# Initial-owner address (read-only — Stage 1 only needs the address, not the key, to
# pass into the L2UpgradeConfig). Defaults to vm.envAddress("INITIAL_OWNER") if set.
L2_INITIAL_OWNER=0x...

# Chainlink CRE Forwarder address on OP Sepolia (input to step 1). Sepolia is the opt-out lane, so this
# IS read from env (the four mainnet lanes pin it in code via <Lane>MigrationConstants.CRE_FORWARDER).
# Per the Chainlink production forwarder directory the OP Sepolia forwarder is the value below.
L2_CRE_FORWARDER=0x76c9cf548b4179F8901cda1f8623568b58215E62

# ===========================================
# Step 1.5 — sepolia-verify-stage1 (read-only, callable by anyone)
# ===========================================
# Stage-1 outputs from `runDeploy()` — paste them here before running verify/migrate.
L2_ORACLE_POOL=0x...
L2_SYNC_TRIGGER=0x...
L2_CRE_RECEIVER=0x...
# Address (not key) of the Lido Deployer used in step 1. NOT the expectedAuthor (that is the LOL
# multisig / L2_LIQUIDITY_OWNER). Used by state-mate to assert hasRole(DEFAULT_ADMIN_ROLE) == false
# for this hot key post-migration, and to compute deployed CREATE addresses.
L2_LIDO_DEPLOYER_ADDRESS=0x...

# ===========================================
# Step 2 — sepolia-migrate-stage2 (Initial Owner migrates L2 state)
# ===========================================
# Initial-owner key used to broadcast the migration transactions. On testnet you may
# reuse DEPLOYER_PRIVATE_KEY here (the bootstrap CSR's initialAdmin = the deployer).
INITIAL_OWNER_PRIVATE_KEY=0x...

# ===========================================
# Step 3 — sepolia-upgrade-l1 (migrate L1 admin)
# ===========================================
L1_LIDO_CUSTOM_RECEIVER=0x...
L1_PROXY_ADMIN=0x...
LIDO_DAO_AGENT=0x...

# ===========================================
# Optional: Etherscan verification
# ===========================================
# ETHERSCAN_API_KEY=your_etherscan_api_key
