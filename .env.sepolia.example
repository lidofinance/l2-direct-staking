###############################################################################
### Sepolia Testnet Environment Variables                                   ###
### Copy to .env.sepolia and fill in your values                            ###
### NEVER commit actual secrets to version control                          ###
###############################################################################

# ===========================================
# RPC URLs (required)
# ===========================================
L1_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
L2_OPTIMISM_SEPOLIA_RPC_URL=https://opt-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# ===========================================
# Step 1: CSR Infrastructure Deploy (SepoliaCSRDeploy)
# ===========================================
# Private key of the deployer account (must be funded with Sepolia ETH on both chains)
DEPLOYER_PRIVATE_KEY=0x...

# ===========================================
# Step 2: L2 Upgrade (SepoliaL2Upgrade)
# ===========================================
# These addresses are output by step 1 (SepoliaCSRDeploy)
L2_BOOTSTRAP_SYNC_AUTOMATION=0x...
L2_CUSTOM_SENDER=0x...
L2_PROXY_ADMIN=0x...
L2_PRICE_ORACLE=0x...

# Private key of the initial owner (same as DEPLOYER_PRIVATE_KEY for testnet)
INITIAL_OWNER_PRIVATE_KEY=0x...
# Private key for the Lido deployer account
L2_LIDO_DEPLOYER_PRIVATE_KEY=0x...
# L2 governance executor address (receives admin/ownership after migration)
L2_GOVERNANCE_EXECUTOR=0x...
# Optional: separate liquidity owner (defaults to L2_GOVERNANCE_EXECUTOR)
# L2_LIQUIDITY_OWNER=0x...

# Chainlink CRE Forwarder address on OP Sepolia (input to step 2)
# L2_CRE_FORWARDER=0x...

# ===========================================
# Step 4: L1 Upgrade (SepoliaL1Upgrade)
# ===========================================
# These addresses are output by step 1 (SepoliaCSRDeploy)
L1_LIDO_CUSTOM_RECEIVER=0x...
L1_PROXY_ADMIN=0x...
# Address that will become the new L1 admin
LIDO_DAO_AGENT=0x...

# ===========================================
# Optional: Etherscan verification
# ===========================================
# ETHERSCAN_API_KEY=your_etherscan_api_key
