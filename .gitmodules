[submodule "lib/chainlink-local"]
	path = lib/chainlink-local
	url = https://github.com/smartcontractkit/chainlink-local
[submodule "lib/chainlink-csr"]
	path = lib/chainlink-csr
	url = https://github.com/Aphyla/chainlink-csr
	branch = main
[submodule "lib/openzeppelin-contracts"]
	path = lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "lib/openzeppelin-contracts-upgradeable"]
	path = lib/openzeppelin-contracts-upgradeable
	url = https://github.com/OpenZeppelin/openzeppelin-contracts-upgradeable
[submodule "lib/state-mate"]
	path = lib/state-mate
	url = https://github.com/lidofinance/state-mate
