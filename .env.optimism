# Lane tier — lane facts + RPC bindings to the machine-level RPC_<CHAIN>_REMOTE vars. Keys live in the
# root .env; tool-specific spellings are derived by script/shared/cre-env.sh. `just env-doctor` shows
# what resolves. (L2_STATE_MATE_RPC_URL / L2_<NET>_RPC_URL remain honoured as optional overrides.)
L2_NETWORK=optimism
L1_RPC_URL=${RPC_ETHEREUM_REMOTE}
L2_RPC_URL=${RPC_OPTIMISM_REMOTE}
DIFFYSCAN_EXPLORER_HOSTNAME=optimism.blockscout.com

L2_ORACLE_POOL=0xac143bF41BBA4a8014b4Ef5a5F46b39a36AE40A8
# Automation pair v2 — redeployed 2026-07-29 by `just deploy-automation`, owned by the Automation
# Owner 0xBdF111fec2e818Ad9c76fbBaE46144746AD55773. The pool above was NOT redeployed.
L2_SYNC_TRIGGER=0x871a5cddE9813627Ff37A2895A0c9B117A664622
L2_CRE_RECEIVER=0x09BdB4E8BA68d245DCb1c6fbEb1e4f13b57cc69A
L2_TEST_DEPLOYER=0xBeedf0c72D63eE8f8784eDB4A9326Fb43b69D50c
# Retired v1 pair (LOL-owned, deployed 2026-07-23). The v1 trigger still holds SYNC_ROLE and is the
# revoke target for the §S6 cutover — OZ revokeRole is a SILENT no-op on a wrong address, so keep it
# pinned here rather than remembered.
L2_RETIRED_SYNC_TRIGGER=0x1594705D5f9BbDb36453ACF15C94d041c0E02c62
L2_RETIRED_CRE_RECEIVER=0x29113eD7AE4C97Ee2F20A5511C852aa37C0d6b85
